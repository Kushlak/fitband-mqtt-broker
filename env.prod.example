# Production Environment Configuration

# Server Configuration
NODE_ENV=production
HTTP_PORT=8080
HTTPS_PORT=443

# HTTPS/TLS Configuration
# Use 'false' in production if using Nginx reverse proxy
# Nginx will handle TLS termination
ENABLE_HTTPS=false

# Database Configuration
# PostgreSQL connection string (AWS RDS or other)
DATABASE_URL=postgresql://username:password@your-rds-endpoint.rds.amazonaws.com:5432/fitband_broker

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# API Security
# Generate strong API key: openssl rand -hex 32
API_KEY=your-production-api-key-here

# Prisma
PRISMA_CLIENT_ENGINE_TYPE=binary
RUN_MIGRATIONS=true

# DuckDNS (optional, for dynamic DNS)
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=your-duckdns-token

